# Copy to .env. Fill in your own account/operator details; never commit .env.
BOT_NUMBER=
BOT_UUID=
ADMIN_NUMBERS=
BOT_MENTION_NAME=Assistant
BOT_PERSONA=assistant
BOT_CMD_PREFIX=/bot
CONTACTS_FILE=contacts.json

# Host-side Python calls the complete native Ollama endpoint.
OLLAMA_URL=http://localhost:11434/api/chat
MODEL_ID=llama3.1:8b

# Container-side CLI settings. These are independent of the image's REST MODE.
SIGNAL_CONTAINER_NAME=signal-assistant-api
SIGNAL_CLI_BINARY=signal-cli-native
SIGNAL_CLI_CONFIG_DIR=/home/.local/share/signal-cli
RECEIVE_TIMEOUT_SECONDS=30
# Advanced: host-side data reader only; does not alter script mounts/cleanup.
# SIGNAL_DATA_DIR=/absolute/path/to/signal-data/data

MAX_IN_FLIGHT_MESSAGES=4
STATE_TTL_SECONDS=86400
MAX_CACHED_SERVICE_IDS=2048
SUMMARY_EVERY=10
SUMMARY_MAX_TOKENS=300
THINK_MAX_TOKENS=600
